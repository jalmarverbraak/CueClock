{
  "name": "@cueclock/electron",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "prepare-vendor": "node scripts/prepare-vendor.js",
    "build": "npm run prepare-vendor && tsc -p tsconfig.json",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@cueclock/server": "0.1.0",
    "@cueclock/shared": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "nl.webinary.cueclock",
    "productName": "CueClock",
    "files": ["dist/**/*", "vendor/**/*", "package.json"],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}
