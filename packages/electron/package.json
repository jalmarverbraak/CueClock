{
  "name": "@cueclock/electron",
  "version": "1.0.3",
  "private": true,
  "description": "CueClock desktop app - control panel and fullscreen output display",
  "author": {
    "name": "Webinary Media",
    "email": "jalmar@webinary.nl"
  },
  "homepage": "https://github.com/Webinary-Media/tijd-voor-timer",
  "main": "dist/main.js",
  "scripts": {
    "prepare-vendor": "node scripts/prepare-vendor.js",
    "build": "npm run prepare-vendor && tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@cueclock/server": "0.1.0",
    "@cueclock/shared": "0.1.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "electron": "32.3.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "nl.webinary.cueclock",
    "productName": "CueClock",
    "executableName": "cueclock",
    "files": [
      "dist/**/*",
      "vendor/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "electronVersion": "32.3.3",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "afterPack": "scripts/afterPack.js",
    "publish": {
      "provider": "github",
      "owner": "Webinary-Media",
      "repo": "tijd-voor-timer"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CueClock"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
